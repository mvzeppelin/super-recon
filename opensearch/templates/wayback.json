{
  "index_patterns": ["*-wayback"],
  "composed_of": ["recon-common-mappings"],
  "priority": 100,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "url":        { "type": "keyword" },
        "domain":     { "type": "keyword" },
        "path":       { "type": "keyword" },
        "has_params": { "type": "boolean" }
      }
    }
  }
}
