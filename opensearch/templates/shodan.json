{
  "index_patterns": ["*-shodan"],
  "composed_of": ["recon-common-mappings"],
  "priority": 100,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "ip":         { "type": "ip" },
        "port":       { "type": "integer" },
        "transport":  { "type": "keyword" },
        "product":    { "type": "keyword" },
        "version":    { "type": "keyword" },
        "cpe":        { "type": "keyword" },
        "org":        { "type": "text" },
        "isp":        { "type": "text" },
        "country":    { "type": "keyword" },
        "city":       { "type": "keyword" },
        "hostnames":  { "type": "keyword" },
        "vulns":      { "type": "keyword" }
      }
    }
  }
}
