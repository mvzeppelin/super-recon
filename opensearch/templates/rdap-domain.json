{
  "index_patterns": ["*-rdap-domain"],
  "composed_of": ["recon-common-mappings"],
  "priority": 100,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "domain":       { "type": "keyword" },
        "handle":       { "type": "keyword" },
        "nameservers":  { "type": "keyword" },
        "registrant":   { "type": "text" },
        "events": {
          "type": "nested",
          "properties": {
            "eventAction": { "type": "keyword" },
            "eventDate":   { "type": "date" }
          }
        }
      }
    }
  }
}
