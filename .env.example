# =========================================================
# super-recon — configuração base (Etapa 1)
# Copie este arquivo para ".env" e ajuste os valores.
#
# Isso aqui é só o que precisa existir antes de subir o ambiente
# (credenciais, bind/porta, caminho de volume, paralelismo). Timeout de
# ferramenta, notificação, limites de upload, integrações (Shodan/Censys/
# WPScan/Slack) e afins são configurados com o sistema já no ar, pela tela
# "Configurações" (login como admin) — ver README "Configurações".
# =========================================================

# ---- Paralelismo ----
# Quantidade de CPUs usadas para rodar as ferramentas do Kali em paralelo.
# Deixe em branco para usar todos os cores disponíveis no host.
RECON_CPUS=

# ---- Redis (fila de jobs do orquestrador, Etapa 5) ----
REDIS_PASSWORD=changeme_redis

# ---- OpenSearch (configurado na Etapa 2) ----
OPENSEARCH_ADMIN_USER=admin
# Evite aspas simples (') na senha — é o único caractere que ainda quebra o
# healthcheck do opensearch no docker-compose.yml (todo o resto — parênteses,
# espaço, $, ; etc. — já é protegido). OpenSearch exige no mínimo 8
# caracteres com maiúscula, minúscula, número e símbolo.
OPENSEARCH_ADMIN_PASSWORD=changeme_ChangeMe123!
# Porta do OpenSearch — recomendado manter em 127.0.0.1 sempre (é a base de
# dados crua, com as credenciais acima; login da aplicação é outra coisa,
# sempre exigido, ver README "Autenticação e usuários").
OPENSEARCH_HOST_BIND=127.0.0.1

# ---- Exposição de rede do frontend/backend ----
# 127.0.0.1 (padrão) = só acessível da própria máquina. 0.0.0.0 = acessível
# de qualquer IP que alcançar o host (LAN, ou a internet se a máquina tiver
# IP público/estiver numa VPS) — antes de trocar pra 0.0.0.0, troque a senha
# do usuário admin semeado na instalação (ver README "Autenticação e
# usuários"). Também aceita um IP específico da LAN (ex: 192.168.1.10).
BACKEND_HOST_BIND=127.0.0.1
FRONTEND_HOST_BIND=127.0.0.1
# Porta exposta no host — troque se 3000/8000 já estiverem em uso (outro
# serviço, ou uma segunda instância do super-recon na mesma máquina). Só
# afeta o lado de fora do container; internamente continua 80 (nginx) e
# 8000 (uvicorn) de sempre, então não precisa mexer em mais nada.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Retenção de dados (ILM básico via ISM do OpenSearch) ----
# Dias até um índice ser apagado automaticamente. Vazio (padrão) = nunca
# expira — mantém o comportamento de sempre até você optar por configurar.
# "curta" vale para wayback/katana (alto volume, baixo valor de longo prazo);
# "longa" vale pra todo o resto (achados de mais peso como nuclei/subdomains,
# e os metadados de execução em jobs/scans). Ver README "Retenção de dados".
ILM_SHORT_RETENTION_DAYS=
ILM_LONG_RETENTION_DAYS=

# ---- Kiterunner (content-discovery focado em API, Fase 4) ----
# Nome da wordlist cacheada no build da imagem kali-tools — raramente
# precisa mudar. Se ligar o kiterunner (checklist de scan, ou
# KITERUNNER_ENABLED na tela "Configurações"), é essa wordlist que ele usa.
#KITERUNNER_WORDLIST=apiroutes-260227
